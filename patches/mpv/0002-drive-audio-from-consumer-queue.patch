+/** Buffered sink API (experimental). Install before mpv_initialize().
+ * The vtable and user_data must remain alive until mpv_terminate_destroy()
+ * returns. Callbacks are serialized by mpv's AO lock, on mpv-owned threads;
+ * they must not call libmpv APIs. The consumer may read its buffer concurrently.
+ * No callback may retain the write() data pointer after returning.
+ */
+typedef struct mpv_godot_audio_sink_state {
+    int free_frames;
+    int queued_frames;
+    double delay_seconds; // Queued PCM plus estimated downstream output latency.
+    int playing;         // Clear on starvation/drain, including at EOF.
+} mpv_godot_audio_sink_state;
+
+typedef struct mpv_godot_audio_sink {
+    // Return 0 on success. Configure bounded interleaved float32 storage.
+    int (*configure)(void *ctx, int sample_rate, int channels, int capacity_frames);
+    // Stop consumption and discard all queued PCM, including on seeks.
+    void (*reset)(void *ctx);
+    // Pause preserves queued PCM. write() never starts consumption itself.
+    void (*set_playing)(void *ctx, int playing);
+    // Return 0 on success; frames never exceeds get_state().free_frames.
+    int (*write)(void *ctx, const float *data, int frames);
+    void (*get_state)(void *ctx, mpv_godot_audio_sink_state *state);
+} mpv_godot_audio_sink;
+
+MPV_EXPORT int mpv_godot_audio_set_sink(mpv_handle *ctx, void *user_data,
+                                      const mpv_godot_audio_sink *sink);
+
