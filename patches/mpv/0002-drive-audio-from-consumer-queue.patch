+int mpv_godot_audio_set_sink(mpv_handle *ctx, void *user_data,
+                           const struct mpv_godot_audio_sink *sink)
+{
+    // The sink is immutable once initialization starts.
+    if (ctx->mpctx->initialized)
+        return MPV_ERROR_INVALID_PARAMETER;
+    struct mp_client_api *clients = ctx->clients;
+    mp_mutex_lock(&clients->lock);
+    clients->godot_audio_sink_user_data = user_data;
+    clients->godot_audio_sink = sink;
+    mp_mutex_unlock(&clients->lock);
+    return 0;
+}
+
+bool mp_godot_audio_get_sink(struct mpv_global *g, void **user_data,
+                           const struct mpv_godot_audio_sink **sink)
+{
+    struct mp_client_api *clients = g->client_api;
+    mp_mutex_lock(&clients->lock);
+    *user_data = clients->godot_audio_sink_user_data;
+    *sink = clients->godot_audio_sink;
+    mp_mutex_unlock(&clients->lock);
+    return *sink != NULL;
+}
