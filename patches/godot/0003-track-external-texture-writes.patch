+
+// Synchronous prototype handoff for a native Vulkan color-attachment writer.
+// The caller must finish its GPU work and return ownership in COLOR_ATTACHMENT
+// layout before any further RD calls. RD then supplies the next consumer barrier.
+Error RenderingDevice::texture_prepare_for_external_write(RID p_texture) {
+	ERR_RENDER_THREAD_GUARD_V(ERR_UNAVAILABLE);
+	Texture *tex = texture_owner.get_or_null(p_texture);
+	ERR_FAIL_NULL_V(tex, ERR_INVALID_PARAMETER);
+	ERR_FAIL_COND_V(!(tex->usage_flags & TEXTURE_USAGE_COLOR_ATTACHMENT_BIT), ERR_INVALID_PARAMETER);
+	_texture_check_pending_clear(p_texture, tex);
+	_check_transfer_worker_texture(tex);
+	CallbackResource resource{ p_texture, CALLBACK_RESOURCE_TYPE_TEXTURE, CALLBACK_RESOURCE_USAGE_ATTACHMENT_COLOR_READ_WRITE };
+	Error err = driver_callback_add([](RDD *, RDD::CommandBufferID, void *) {}, nullptr,
+			VectorView<CallbackResource>(&resource, 1));
+	ERR_FAIL_COND_V(err != OK, err);
+	// Execute the transition and finish earlier uses before the external writer
+	// touches the image. This also handles first use and readback layout changes.
+	_flush_and_stall_for_all_frames();
+	return OK;
 }
 
